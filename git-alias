}

# exp <branch > [-fC]
# Send a branch to dm/<branch>-working
# If it is already there, show the commits instead
# Use -f to force
# Use -C to skip running CI tests
function exp() {
	local branch
	local force
	local skipci

	OPTIND=0
	while getopts "Cf" opt; do
		case $opt in
		C )
		  skipci="-o ci.skip"
		  ;;
		f )
		  force="-f"
		  ;;
		\? )
		  echo "Invalid option: $OPTARG" 1>&2
		  exit 1
		  ;;
		esac
	done

	shift $((OPTIND -1))

	branch="$1"

	if [ -z "${branch}" ]; then
		branch=$(git rev-parse --abbrev-ref HEAD)
		echo "Using branch ${branch}"
		[ -z "${branch}" ] && exit 1
	fi

	# Drop any version number, so 'spl2' becomes 'spl'
	exp_branch=$(echo $branch |sed 's/[0-9].*//')

	target="${exp_branch}-working"
	if ! git push ${force} ${skipci} dm "HEAD:$target"; then
		gmb "dm/${target}"
	fi
}

# imp <branch > [-f]
# Obtain a branch from dm/<branch>-working
# If it is already available locally, show the commits instead
# Use -f to force
function imp() {
	local branch
	local force

	for arg in $@; do
		if [ "$arg" = "-f" ]; then
			force=1
		else
			branch="$arg"
		fi
		shift
	done

	# Drop any version number, so 'spl2' becomes 'spl'
	exp_branch=$(echo $branch |sed 's/[0-9].*//')

	target="${exp_branch}-working"

	if git status -sb |grep -q " M "; then
		echo "Local tree is not clean"
		return
	fi

	if ! git checkout -b ${branch} dm/${target}; then
		if [ -n "${force}" ]; then
			if git checkout ${branch}; then
				git reset --hard dm/${target}
			fi
		else
			gmb "${branch}"
		fi
	fi
}

# Get the hex size of a file
hs() {
	printf %x $(stat -c %s $1)
	echo
}

# Get the size of a file in K
sk() {
	printf %d $(($(stat -c %s $1) / 1024))
	echo
}

